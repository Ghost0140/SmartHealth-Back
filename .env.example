# Copy to .env and replace every placeholder with private values.
# Generate the shared JWT key with: openssl rand -base64 32
DB_USERNAME=root
DB_PASSWORD=replace-with-a-strong-local-database-password
SMARTHEALTH_JWT_SECRET_BASE64=replace-with-output-of-openssl-rand-base64-32
SMARTHEALTH_CHAT_INTERNAL_TOKEN=replace-with-a-long-random-token
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_APP_PASSWORD=replace-with-a-strong-app-password
